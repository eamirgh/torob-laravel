{
    "name": "eamirgh/torob-laravel",
    "description": "Torob Products and Orders Sync integration for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Amir Ghaffari"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-sodium": "*",
        "ext-json": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Torob\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Torob\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Torob\\Laravel\\TorobServiceProvider"
            ],
            "aliases": {
                "Torob": "Torob\\Laravel\\Facades\\Torob"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
